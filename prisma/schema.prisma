  @@index([sourceId])
  @@index([batchId])
  @@index([districtId])
  @@index([jobRoleId])
  @@index([sectorId])
  @@index([economicClusterId])
  @@index([postedAt])
  @@map("job_postings")
}

model EmployerSurvey {
