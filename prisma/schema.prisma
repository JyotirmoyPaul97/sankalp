// =====================================================================
// KAUSHAL DRISHTI — Prisma Schema (Phase 1 + Phase 2)
// Maharashtra Skill Intelligence & Policy Decision Platform
// ---------------------------------------------------------------------
// Adapted for SQLite: no native enums (String + app-level validation),
// no native UUID (cuid), no PostGIS (Float lat/long, geospatial-ready
// for future PostgreSQL/PostGIS migration without logical changes).
//
// Phase 2 additions:
//   - Extended DataSource (provider, geography_level, frequency, is_active)
//   - UploadedFile (file metadata + checksums)
//   - IngestionBatch (per-import summary + quality score)
//   - IngestionRecord (raw record tracking + provenance + fingerprint)
//   - IngestionError (per-record validation errors/warnings)
//   - AuditLog (ingestion audit events)
//   - Entity-specific evidence tables: JobPosting, EmployerSurvey,
//     IndustryConsultation, SectorGrowth, PlacementOutcome, TechnologyTrend
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Core user / RBAC foundation
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Stored as a demo-only plain marker in Phase 1. Replace with hashed
  // credentials / OAuth2 subject when Keycloak is wired in a later phase.
  passwordHash String   @map("password_hash")
  // STATE_ADMIN | DISTRICT_PLANNER | TRAINING_PROVIDER | EMPLOYER |
  // INSTITUTION | TRAINER | CANDIDATE | AUDITOR
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------

// ---------------------------------------------------------------------
// PHASE 4 — Geographic hierarchy: Division (above District)
// ---------------------------------------------------------------------

model Division {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  stateCode String   @map("state_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts District[]

  @@map("divisions")
}

model District {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  // ISO state code, e.g. MH for Maharashtra
  stateCode String   @map("state_code")
  divisionId String? @map("division_id")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  division         Division?         @relation(fields: [divisionId], references: [id])
  employers       Employer[]
  institutions    Institution[]
  jobPostings     JobPosting[]      @relation("JobPostingDistrict")
  employerSurveys EmployerSurvey[]  @relation("EmployerSurveyDistrict")
  placementOutcomes PlacementOutcome[] @relation("PlacementOutcomeDistrict")
  economicClusters EconomicCluster[]
  marketSignals    MarketSignal[]

  @@index([stateCode])
  @@index([divisionId])
  @@map("districts")
}

// ---------------------------------------------------------------------
// PHASE 4 — Economic Cluster (local industry concentration)
// Maharashtra → Division → District → Economic Cluster → Sector → Employer
// ---------------------------------------------------------------------

model EconomicCluster {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  districtId  String?  @map("district_id")
  sectorId    String?  @map("sector_id")
  clusterType String?  @map("cluster_type")  // e.g. AUTO_HUB, IT_CORRIDOR, MFG_ZONE
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  district    District? @relation(fields: [districtId], references: [id])
  sector      Sector?   @relation("EconomicClusterSector", fields: [sectorId], references: [id])
  employers   EmployerCluster[]
  jobPostings JobPosting[]
  marketSignals MarketSignal[]

  @@index([districtId])
  @@index([sectorId])
  @@map("economic_clusters")
}

model EmployerCluster {
  id         String   @id @default(cuid())
  employerId String   @map("employer_id")
  clusterId  String   @map("cluster_id")

  employer   Employer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  cluster    EconomicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([employerId, clusterId])
  @@index([clusterId])
  @@map("employer_clusters")
}

// ---------------------------------------------------------------------
// Economic / training taxonomy
// ---------------------------------------------------------------------

model Sector {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employers             Employer[]              @relation("EmployerSector")
  jobRoles              JobRole[]               @relation("JobRoleSector")
  courses               Course[]                @relation("CourseSector")
  jobPostings           JobPosting[]            @relation("JobPostingSector")
  industryConsultations IndustryConsultation[]  @relation("IndustryConsultationSector")
  sectorGrowth          SectorGrowth[]           @relation("SectorGrowthSector")
  technologyTrends      TechnologyTrend[]        @relation("TechnologyTrendSector")
  economicClusters      EconomicCluster[]        @relation("EconomicClusterSector")
  marketSignals         MarketSignal[]

  @@map("sectors")
}

model Skill {
  id             String   @id @default(cuid())
  name           String
  canonicalName  String   @unique @map("canonical_name")
  description    String?
  // e.g. "Technical", "Process", "Digital", "Safety", "Soft"
  category       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  roleSkills   RoleSkill[]
  courseSkills  CourseSkill[]
  aliases       SkillAlias[]
  relationsFrom SkillRelation[] @relation("SkillRelationFrom")
  relationsTo   SkillRelation[] @relation("SkillRelationTo")
  clusterMembers SkillClusterMember[]

  @@index([category])
  @@map("skills")
}

// ---------------------------------------------------------------------
// PHASE 3 — Skill aliases (alternate surface forms → canonical skill)
// e.g. "PLC" / "Programmable Logic Controller" → Skill "PLC Programming"
// ---------------------------------------------------------------------

model SkillAlias {
  id          String   @id @default(cuid())
  skillId     String   @map("skill_id")
  alias       String
  aliasType   String   @default("VARIANT") @map("alias_type")
  // ACRONYM | VARIANT | COMMON_NAME | LEGACY
  isCaseSensitive Boolean @default(false) @map("is_case_sensitive")
  createdAt   DateTime @default(now()) @map("created_at")

  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([alias, isCaseSensitive])
  @@index([skillId])
  @@index([alias])
  @@map("skill_aliases")
}

// ---------------------------------------------------------------------
// PHASE 3 — Skill relations (knowledge graph edges)
// ---------------------------------------------------------------------

model SkillRelation {
  id           String   @id @default(cuid())
  fromSkillId String   @map("from_skill_id")
  toSkillId    String   @map("to_skill_id")
  // PREREQUISITE | RELATED_TO | BROADER_THAN | NARROWER_THAN | PART_OF
  relationType String   @default("RELATED_TO") @map("relation_type")
  weight       Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  fromSkill    Skill    @relation("SkillRelationFrom", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkill      Skill    @relation("SkillRelationTo", fields: [toSkillId], references: [id], onDelete: Cascade)

  @@unique([fromSkillId, toSkillId, relationType])
  @@index([fromSkillId])
  @@index([toSkillId])
  @@index([relationType])
  @@map("skill_relations")
}

// ---------------------------------------------------------------------
// PHASE 3 — Skill clusters (thematic groupings)
// e.g. "Industrial Automation" cluster: PLC Programming, SCADA, Industrial Robotics
// ---------------------------------------------------------------------

model SkillCluster {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     SkillClusterMember[]

  @@map("skill_clusters")
}

model SkillClusterMember {
  id          String   @id @default(cuid())
  clusterId   String   @map("cluster_id")
  skillId     String   @map("skill_id")
  // PRIMARY | SECONDARY
  membershipType String @default("PRIMARY") @map("membership_type")

  cluster     SkillCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  skill       Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([clusterId, skillId])
  @@index([skillId])
  @@map("skill_cluster_members")
}

model JobRole {
  id             String   @id @default(cuid())
  title          String
  canonicalTitle String   @unique @map("canonical_title")
  description    String?
  sectorId       String?  @map("sector_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sector      Sector?       @relation("JobRoleSector", fields: [sectorId], references: [id])
  roleSkills RoleSkill[]
  employerRoles EmployerRole[]
  jobPostings  JobPosting[]
  employerSurveys EmployerSurvey[]

  @@map("job_roles")
}

model Qualification {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  description       String?
  // e.g. "Certificate", "Diploma", "Advanced Diploma", "Degree"
  qualificationLevel String  @map("qualification_level")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("qualifications")
}

// ---------------------------------------------------------------------
// Training supply
// ---------------------------------------------------------------------

model Institution {
  id              String   @id @default(cuid())
  name            String
  // e.g. "ITI", "Polytechnic", "Skill Centre", "Private Training Provider"
  institutionType String   @map("institution_type")
  districtId      String?  @map("district_id")
  description     String?
  address         String?
  latitude        Float?
  longitude       Float?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  district          District?          @relation(fields: [districtId], references: [id])
  courseInstitutions CourseInstitution[]
  placementOutcomes PlacementOutcome[]

  @@index([districtId])
  @@map("institutions")
}

model Course {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  description     String?
  sectorId        String?  @map("sector_id")
  qualificationId String?  @map("qualification_id")
  durationHours   Int      @map("duration_hours")
  // DRAFT | ACTIVE | UNDER_REVIEW | DEPRECATED
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sector       Sector?           @relation("CourseSector", fields: [sectorId], references: [id])
  qualification Qualification?   @relation(fields: [qualificationId], references: [id])
  courseSkills CourseSkill[]
  courseInstitutions CourseInstitution[]
  placementOutcomes PlacementOutcome[]

  @@index([sectorId])
  @@index([qualificationId])
  @@map("courses")
}

// ---------------------------------------------------------------------
// Employers
// ---------------------------------------------------------------------

model Employer {
  id               String   @id @default(cuid())
  name             String
  industrySectorId String?  @map("industry_sector_id")
  districtId       String?  @map("district_id")
  description      String?
  website          String?
  // MICRO | SMALL | MEDIUM | LARGE | ENTERPRISE
  sizeCategory     String   @default("MEDIUM") @map("size_category")
  isVerified       Boolean  @default(false) @map("is_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  industrySector Sector?       @relation("EmployerSector", fields: [industrySectorId], references: [id])
  district       District?     @relation(fields: [districtId], references: [id])
  employerRoles  EmployerRole[]
  jobPostings    JobPosting[]
  employerSurveys EmployerSurvey[]
  clusters       EmployerCluster[]
  marketSignals  MarketSignal[]

  @@index([industrySectorId])
  @@index([districtId])
  @@map("employers")
}

// ---------------------------------------------------------------------
// Relationship tables
// ---------------------------------------------------------------------

model RoleSkill {
  id        String   @id @default(cuid())
  jobRoleId String   @map("job_role_id")
  skillId   String   @map("skill_id")
  // 1-5 importance weight (legacy Phase 1 field)
  importance Int      @default(3)
  // Phase 3: expected proficiency for the role
  // AWARENESS | WORKING | PROFICIENT | EXPERT
  proficiencyLevel String @default("WORKING") @map("proficiency_level")
  jobRole   JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, skillId])
  @@index([skillId])
  @@index([proficiencyLevel])
  @@map("role_skills")
}

model CourseSkill {
  id            String   @id @default(cuid())
  courseId      String   @map("course_id")
  skillId       String   @map("skill_id")
  // NONE | INTRODUCED | REINFORCED | MASTERED
  coverageLevel String   @default("INTRODUCED") @map("coverage_level")
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([skillId])
  @@map("course_skills")
}

model CourseInstitution {
  id            String      @id @default(cuid())
  courseId      String      @map("course_id")
  institutionId String      @map("institution_id")
  capacity      Int         @default(0)
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([courseId, institutionId])
  @@index([institutionId])
  @@map("course_institutions")
}

model EmployerRole {
  id        String   @id @default(cuid())
  employerId String  @map("employer_id")
  jobRoleId String   @map("job_role_id")
  employer  Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  jobRole   JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@unique([employerId, jobRoleId])
  @@index([jobRoleId])
  @@map("employer_roles")
}

// ---------------------------------------------------------------------
// Data provenance
// ---------------------------------------------------------------------

model DataSource {
  id            String    @id @default(cuid())
  name          String
  // JOB_POSTINGS | EMPLOYER_SURVEY | INDUSTRY_CONSULTATION | SECTOR_GROWTH |
  // PLACEMENT_OUTCOME | TECHNOLOGY_TREND | TRAINING_DATA | COURSE_DATA |
  // INSTITUTION_DATA | TRAINER_DATA | EQUIPMENT_DATA | OTHER
  sourceType    String    @map("source_type")
  description   String?
  // Provider abstraction: SyntheticDataProvider | CSVDataProvider |
  // JSONDataProvider | ManualEntryProvider | (future: OfficialGovernmentProvider)
  providerName  String?   @map("provider_name")
  sourceUrl     String?   @map("source_url")
  // External reference code/identifier from the originating system
  sourceReference String? @map("source_reference")
  // REAL | SYNTHETIC | MODELLED | DEMO | UNKNOWN
  dataStatus    String    @default("DEMO") @map("data_status")
  // STATE | DIVISION | DISTRICT | TALUKA | INSTITUTION | EMPLOYER | NATIONAL | OTHER
  geographyLevel String? @map("geography_level")
  // DAILY | WEEKLY | MONTHLY | QUARTERLY | ANNUAL | ADHOC
  updateFrequency String? @map("update_frequency")
  lastUpdatedAt DateTime? @map("last_updated_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  batches              IngestionBatch[]
  ingestionRecords     IngestionRecord[]
  jobPostings          JobPosting[]            @relation("JobPostingSource")
  employerSurveys      EmployerSurvey[]        @relation("EmployerSurveySource")
  industryConsultations IndustryConsultation[]  @relation("IndustryConsultationSource")
  sectorGrowth          SectorGrowth[]           @relation("SectorGrowthSource")
  placementOutcomes    PlacementOutcome[]      @relation("PlacementOutcomeSource")
  technologyTrends     TechnologyTrend[]        @relation("TechnologyTrendSource")

  @@index([dataStatus])
  @@index([sourceType])
  @@index([isActive])
  @@map("data_sources")
}

// =====================================================================
// PHASE 2 — DATA & EVIDENCE INGESTION LAYER
// =====================================================================

// ---------------------------------------------------------------------
// Uploaded file metadata (physical file lives in storage/ abstraction)
// ---------------------------------------------------------------------

model UploadedFile {
  id           String   @id @default(cuid())
  fileName     String   @map("file_name")
  // Original client filename (sanitized)
  fileType     String   @map("file_type")
  // Storage key under storage/ (e.g. "ingestion/2026/09/<cuid>.csv")
  storageKey   String   @unique @map("storage_key")
  sizeBytes    Int      @map("size_bytes")
  // SHA-256 hex
  checksum     String   @unique
  uploadedBy   String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  batches IngestionBatch[]

  @@index([checksum])
  @@map("uploaded_files")
}

// ---------------------------------------------------------------------
// Ingestion batch — one per import operation
// ---------------------------------------------------------------------

model IngestionBatch {
  id               String    @id @default(cuid())
  // Human-readable batch ID, e.g. ING-2026-0001
  batchCode        String    @unique @map("batch_code")
  dataSourceId     String    @map("data_source_id")
  uploadedFileId   String?   @map("uploaded_file_id")
  fileName         String?   @map("file_name")
  // csv | json | manual | synthetic
  fileType         String    @default("csv") @map("file_type")
  // REPLACE | APPEND | UPSERT
  importMode       String    @default("UPSERT") @map("import_mode")
  recordsReceived  Int       @default(0) @map("records_received")
  recordsAccepted  Int       @default(0) @map("records_accepted")
  recordsRejected  Int       @default(0) @map("records_rejected")
  recordsDuplicate Int       @default(0) @map("records_duplicate")
  recordsWarning   Int       @default(0) @map("records_warning")
  // UPLOADED | VALIDATING | PROCESSING | COMPLETED |
  // COMPLETED_WITH_WARNINGS | FAILED | CANCELLED
  status           String    @default("UPLOADED")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  errorSummary     String?   @map("error_summary")
  // Deterministic quality score 0-100
  qualityScore     Int?      @map("quality_score")
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  dataSource     DataSource     @relation(fields: [dataSourceId], references: [id])
  uploadedFile   UploadedFile?  @relation(fields: [uploadedFileId], references: [id])
  records        IngestionRecord[]
  errors         IngestionError[]
  jobPostings          JobPosting[]            @relation("JobPostingBatch")
  employerSurveys      EmployerSurvey[]        @relation("EmployerSurveyBatch")
  industryConsultations IndustryConsultation[]  @relation("IndustryConsultationBatch")
  sectorGrowth          SectorGrowth[]           @relation("SectorGrowthBatch")
  placementOutcomes    PlacementOutcome[]      @relation("PlacementOutcomeBatch")
  technologyTrends     TechnologyTrend[]        @relation("TechnologyTrendBatch")

  @@index([dataSourceId])
  @@index([status])
  @@index([createdAt])
  @@map("ingestion_batches")
}

// ---------------------------------------------------------------------
// Raw record tracking — preserves source identity + provenance
// ---------------------------------------------------------------------

model IngestionRecord {
  id              String    @id @default(cuid())
  sourceId        String    @map("source_id")
  batchId         String    @map("batch_id")
  // Original ID from the source system (e.g. JOB-00017)
  sourceRecordId  String?   @map("source_record_id")
  sourceTimestamp DateTime? @map("source_timestamp")
  ingestedAt      DateTime  @default(now()) @map("ingested_at")
  // REAL | SYNTHETIC | MODELLED | DEMO | UNKNOWN (inherited from source)
  dataStatus      String    @default("DEMO") @map("data_status")
  // job_posting | employer_survey | industry_consultation | sector_growth |
  // placement_outcome | technology_trend
  entityType      String    @map("entity_type")
  // ID of the normalized stored record (FK to entity-specific table)
  normalizedId    String?   @map("normalized_id")
  // ACCEPTED | REJECTED | POSSIBLE_DUPLICATE | DUPLICATE
  qualityStatus   String    @default("ACCEPTED") @map("quality_status")
  // Compound fingerprint for dedup (sha256 of key fields)
  fingerprint     String?
  // Original record preserved as JSON
  rawJson         String    @map("raw_json")

  source          DataSource      @relation(fields: [sourceId], references: [id])
  batch           IngestionBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceRecordId])
  @@index([batchId])
  @@index([sourceId])
  @@index([entityType])
  @@index([normalizedId])
  @@index([fingerprint])
  @@map("ingestion_records")
}

// ---------------------------------------------------------------------
// Ingestion errors / warnings — per-record quality issues
// ---------------------------------------------------------------------

model IngestionError {
  id              String   @id @default(cuid())
  batchId         String   @map("batch_id")
  // 1-based row number in the source file
  rowNumber       Int      @map("row_number")
  field           String?
  problem         String
  // ERROR | WARNING | INFO
  severity        String   @default("ERROR")
  suggestedAction String?  @map("suggested_action")
  recordPreview   String?  @map("record_preview")

  batch           IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([severity])
  @@map("ingestion_errors")
}

// ---------------------------------------------------------------------
// Audit log — ingestion + admin actions
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  userEmail  String?  @map("user_email")
  // UPLOADED_DATASET | VALIDATED_DATASET | CONFIRMED_IMPORT | CREATED_SOURCE |
  // UPDATED_SOURCE | DELETED_SOURCE | LOGIN | LOGOUT
  action     String
  resource   String?
  status     String   @default("SUCCESS")
  details    String?
  timestamp  DateTime @default(now())

  @@index([action])
  @@index([timestamp])
  @@index([userId])
  @@map("audit_logs")
}

// =====================================================================
// Entity-specific evidence tables (normalized storage)
// Each links back to IngestionRecord for full provenance.
// =====================================================================

model JobPosting {
  id              String    @id @default(cuid())
  sourceId        String    @map("source_id")
  batchId         String?    @map("batch_id")
  sourceRecordId  String?   @map("source_record_id")
  // Free-text employer name from source (pre-resolution)
  employerName    String    @map("employer_name")
  employerId      String?   @map("employer_id")
  roleTitle       String    @map("role_title")
  jobRoleId       String?   @map("job_role_id")
  districtId      String?   @map("district_id")
  districtName    String?   @map("district_name")
  sectorId        String?   @map("sector_id")
  postedAt        DateTime? @map("posted_at")
  dataStatus      String    @default("DEMO") @map("data_status")
  rawJson         String?   @map("raw_json")
  ingestedAt      DateTime  @default(now()) @map("ingested_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  source          DataSource      @relation("JobPostingSource", fields: [sourceId], references: [id])
  batch           IngestionBatch? @relation("JobPostingBatch", fields: [batchId], references: [id])
  employer        Employer?       @relation(fields: [employerId], references: [id])
  jobRole         JobRole?        @relation(fields: [jobRoleId], references: [id])
  district        District?       @relation("JobPostingDistrict", fields: [districtId], references: [id])
  sector          Sector?         @relation("JobPostingSector", fields: [sectorId], references: [id])

  @@index([sourceId])
  @@index([batchId])
  @@index([districtId])
  @@index([jobRoleId])
  @@index([postedAt])
  @@map("job_postings")
}

model EmployerSurvey {
  id              String    @id @default(cuid())
  sourceId        String    @map("source_id")
  batchId         String?    @map("batch_id")
  sourceRecordId  String?   @map("source_record_id")
  employerName    String    @map("employer_name")
  employerId      String?   @map("employer_id")
  roleTitle       String?   @map("role_title")
  jobRoleId       String?   @map("job_role_id")
  districtId      String?   @map("district_id")
  responseDate    DateTime? @map("response_date")
  // 1-5 satisfaction
  satisfactionScore Int?    @map("satisfaction_score")
  hiringIntent     String?  @map("hiring_intent")
  skillGapsReported String? @map("skill_gaps_reported")
  dataStatus      String    @default("DEMO") @map("data_status")
  rawJson         String?   @map("raw_json")
  ingestedAt      DateTime  @default(now()) @map("ingested_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  source          DataSource      @relation("EmployerSurveySource", fields: [sourceId], references: [id])
  batch           IngestionBatch? @relation("EmployerSurveyBatch", fields: [batchId], references: [id])
  employer        Employer?       @relation(fields: [employerId], references: [id])
  jobRole         JobRole?        @relation(fields: [jobRoleId], references: [id])
  district        District?       @relation("EmployerSurveyDistrict", fields: [districtId], references: [id])

  @@index([sourceId])
  @@index([batchId])
  @@index([employerId])
  @@map("employer_surveys")
}

