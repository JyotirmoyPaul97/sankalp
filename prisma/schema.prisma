  trendDirection  String    @map("trend_direction")
  // 1-5
  impactLevel     Int?      @map("impact_level")
  timeHorizon     String?   @map("time_horizon")
  notes           String?
  dataStatus      String    @default("DEMO") @map("data_status")
  rawJson         String?   @map("raw_json")
