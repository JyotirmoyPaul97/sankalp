// =====================================================================
// PHASE 4 — LABOUR-MARKET & LOCAL ECONOMIC INTELLIGENCE
// =====================================================================

// Configurable evidence-source weights. NOT scientifically validated —
// documented as "initial system configuration, subject to validation".
model EvidenceWeight {
  id             String  @id @default(cuid())
  sourceType     String  @unique @map("source_type") // JOB_POSTING | EMPLOYER_SURVEY | ...
  weight         Float   @default(1.0)
  reliability    Float   @default(0.5) // 0-1
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("evidence_weights")
}

// Per-period market signal — never overwritten (temporal versioning).
// One row per (source_type, entity_scope, period) combination.
model MarketSignal {
  id            String   @id @default(cuid())
  sourceType    String   @map("source_type") // JOB_POSTING | EMPLOYER_SURVEY | ...
  sourceId      String?  @map("source_id")   // DataSource id (provenance)

  districtId    String?  @map("district_id")
  clusterId     String?  @map("cluster_id")
  sectorId      String?  @map("sector_id")

  jobRoleId     String?  @map("job_role_id")
  skillId       String?  @map("skill_id")

  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  periodLabel   String   @map("period_label") // e.g. "2026-09"

  signalValue   Float    @default(0) @map("signal_value")
  signalUnit    String   @default("count") @map("signal_unit")
  direction     String   @default("STABLE") // INCREASING | STABLE | DECREASING | UNKNOWN

  confidence    Float    @default(0) // 0-1
  sourceDiversity Int    @default(1) @map("source_diversity")
  sampleSize    Int      @default(0) @map("sample_size")
  uniqueEmployers Int    @default(0) @map("unique_employers")
  uniquePostings Int     @default(0) @map("unique_postings")

  dataStatus    String   @default("DEMO") @map("data_status")
  rawJson       String?  @map("raw_json")

  createdAt     DateTime @default(now()) @map("created_at")

  district      District?        @relation(fields: [districtId], references: [id])
  cluster       EconomicCluster? @relation(fields: [clusterId], references: [id])
  sector        Sector?          @relation(fields: [sectorId], references: [id])
  jobRole       JobRole?         @relation(fields: [jobRoleId], references: [id])
  skill         Skill?           @relation(fields: [skillId], references: [id])

  @@unique([sourceType, districtId, clusterId, sectorId, jobRoleId, skillId, periodLabel])
  @@index([sourceType])
  @@index([districtId])
  @@index([clusterId])
  @@index([sectorId])
  @@index([jobRoleId])
  @@index([skillId])
  @@index([periodLabel])
  @@index([periodStart])
  @@map("market_signals")
}

// Aggregated demand snapshot — the main market-intelligence object.
model DemandSnapshot {
  id            String   @id @default(cuid())

  // Geography scope: STATE | DISTRICT | CLUSTER
  scope         String   @default("DISTRICT")
  geographyId   String?  @map("geography_id") // district or cluster id
  geographyName String?  @map("geography_name")

  sectorId      String?  @map("sector_id")
  jobRoleId     String?  @map("job_role_id")
  skillId       String?  @map("skill_id")

  period        String   // e.g. "2026-09"

  signalStrength Float   @default(0) @map("signal_strength") // 0-100 normalised
  trendDirection String  @default("UNKNOWN") @map("trend_direction")
  confidence     Float   @default(0)

  evidenceCount  Int     @default(0) @map("evidence_count")
  sourceDiversity Int    @default(0) @map("source_diversity")
  sampleSize     Int     @default(0) @map("sample_size")

  uniqueEmployerCount Int @default(0) @map("unique_employer_count")
  uniquePostingCount   Int @default(0) @map("unique_posting_count")

  // Proficiency distribution (JSON to keep schema simple in SQLite)
  proficiencyDistribution String? @map("proficiency_distribution") // {"AWARENESS":10,"WORKING":55,...}

  dataStatus    String   @default("DEMO") @map("data_status")
  createdAt     DateTime @default(now()) @map("created_at")

  sector   Sector?  @relation(fields: [sectorId], references: [id])
  jobRole  JobRole? @relation(fields: [jobRoleId], references: [id])
  skill    Skill?   @relation(fields: [skillId], references: [id])

  @@index([scope, geographyId])
  @@index([sectorId])
  @@index([jobRoleId])
  @@index([skillId])
  @@index([period])
  @@map("demand_snapshots")
}

// Market profile — aggregated summaries per scope.
model MarketProfile {
  id            String   @id @default(cuid())
  scope         String   // STATE | DISTRICT | CLUSTER | SECTOR
  scopeId       String?  @map("scope_id")

  topRoles      String?  @map("top_roles")      // JSON array
  topSkills     String?  @map("top_skills")     // JSON array
  topSectors    String?  @map("top_sectors")
  emergingSkills String? @map("emerging_skills")
  trendSummary  String?  @map("trend_summary")
  evidenceSummary String? @map("evidence_summary")

  employerCount Int      @default(0) @map("employer_count")
  clusterCount   Int      @default(0) @map("cluster_count")
  avgConfidence  Float    @default(0) @map("avg_confidence")
  dataFreshness  String?  @map("data_freshness")
  dataStatus     String   @default("DEMO") @map("data_status")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeId])
  @@map("market_profiles")
}

// Sector growth profile — aggregated sector-growth intelligence.
model SectorGrowthProfile {
  id            String   @id @default(cuid())
  sectorId      String?  @map("sector_id")
  sectorName    String   @map("sector_name")
  geography     String   // e.g. "Maharashtra" or "Pune"
  period        String

  observedGrowth Float?  @map("observed_growth") // %
  growthDirection String @default("STABLE") @map("growth_direction") // INCREASING | STABLE | DECREASING | INSUFFICIENT_DATA
  changeOverPeriod Float? @map("change_over_period")
  confidence    Float    @default(0)
  evidenceCount Int      @default(0) @map("evidence_count")
  dataStatus    String   @default("DEMO") @map("data_status")

  sector        Sector?  @relation(fields: [sectorId], references: [id])

  @@index([sectorId])
  @@index([geography])
  @@index([period])
  @@map("sector_growth_profiles")
}

// Skill cross-sector presence — transferable skill visibility.
model SkillSectorPresence {
  id            String   @id @default(cuid())
  skillId       String   @map("skill_id")
  sectorId      String   @map("sector_id")

  signalStrength Float   @default(0) @map("signal_strength")
  evidenceCount Int      @default(0) @map("evidence_count")
  confidence    Float    @default(0)

  skill         Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sector        Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([skillId, sectorId])
  @@index([skillId])
  @@index([sectorId])
  @@map("skill_sector_presence")
}

// Emerging skill radar entry.
model EmergingSkillSignal {
  id            String   @id @default(cuid())
  skillId       String   @unique @map("skill_id")

  emergenceStatus String @default("INSUFFICIENT_EVIDENCE") @map("emergence_status") // EARLY_SIGNAL | EMERGING | ACCELERATING | INSUFFICIENT_EVIDENCE
  signalStrength Float   @default(0) @map("signal_strength") // 0-100
  recentActivity Float   @default(0) @map("recent_activity")
  trendVelocity Float   @default(0) @map("trend_velocity")
  persistence   Float   @default(0) // 0-1
  sourceDiversity Int   @default(0) @map("source_diversity")
  technologyLink String? @map("technology_link")
  firstObserved DateTime? @map("first_observed")
  confidence    Float    @default(0)
  evidenceCount Int      @default(0) @map("evidence_count")

  updatedAt     DateTime @updatedAt @map("updated_at")

  skill         Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([emergenceStatus])
  @@index([signalStrength])
  @@map("emerging_skill_signals")
}

// District labour context — demographic foundation (all optional).
// NEVER fabricate. NULL when evidence is unavailable.
model DistrictLabourContext {
  id            String   @id @default(cuid())
  districtId    String   @map("district_id")
  observationPeriod String @map("observation_period")

  population             Int?  @map("population")
  workingAgePopulation   Int?  @map("working_age_population")
  labourForceSize        Int?  @map("labour_force_size")
  educationProfile       String? @map("education_profile") // JSON
  urbanRuralContext      String? @map("urban_rural_context")
  migrationSignal        String? @map("migration_signal")
  sectorConcentration    String? @map("sector_concentration") // JSON

  dataSourceId  String?  @map("data_source_id")
  confidence    Float    @default(0)
  dataStatus    String   @default("UNKNOWN") @map("data_status")

  createdAt     DateTime @default(now()) @map("created_at")

  district      District  @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, observationPeriod])
  @@index([districtId])
  @@map("district_labour_context")
}

// =====================================================================
// PHASE 5 — TRAINING ECOSYSTEM INTELLIGENCE
// =====================================================================

// ---------------------------------------------------------------------
// Training Provider — organisation that operates institutions
// ---------------------------------------------------------------------

model TrainingProvider {
  id             String   @id @default(cuid())
  name           String
  // GOVERNMENT | PRIVATE | INDUSTRY | ACADEMIC | NGO | OTHER | UNKNOWN
  providerType   String   @default("GOVERNMENT") @map("provider_type")
  // PUBLIC | PRIVATE | PPP | TRUST | OTHER
  ownershipType  String   @default("PUBLIC") @map("ownership_type")
  department      String?
  registrationId  String?  @map("registration_id")
  website         String?
  contact         String?
  // ACTIVE | INACTIVE | UNKNOWN
  status         String   @default("ACTIVE")
  dataSourceId   String?  @map("data_source_id")
  dataStatus     String   @default("DEMO") @map("data_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institutions   Institution[]
  courses        Course[]

  @@index([providerType])
  @@map("training_providers")
}

// ---------------------------------------------------------------------
// Training Centre — a physical delivery location under an institution
// ---------------------------------------------------------------------

model TrainingCentre {
  id             String   @id @default(cuid())
  institutionId  String   @map("institution_id")
  name           String
  districtId     String?  @map("district_id")
  talukaId       String?  @map("taluka_id")
  // ITI | POLYTECHNIC | SKILL_CENTRE | PRIVATE_LAB | INDUSTRY_TRAINING_FACILITY | OTHER
  centreType     String   @default("SKILL_CENTRE") @map("centre_type")
  // CLASSROOM | BLENDED | ONLINE | APPRENTICESHIP | OTHER
  deliveryMode   String   @default("CLASSROOM") @map("delivery_mode")
  status         String   @default("ACTIVE")
  dataSourceId   String?  @map("data_source_id")
  dataStatus     String   @default("DEMO") @map("data_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  district       District?      @relation("TrainingCentreDistrict", fields: [districtId], references: [id])
  courseOfferings CourseOffering[]
  supplySignals   TrainingSupplySignal[]

  @@index([institutionId])
  @@index([districtId])
  @@map("training_centres")
}

// ---------------------------------------------------------------------
// Course Offering — temporal course delivery with capacity/enrollment/completion
// A course existing in a catalogue ≠ capacity is currently available.
// ---------------------------------------------------------------------

model CourseOffering {
  id                    String    @id @default(cuid())
  courseId              String    @map("course_id")
  trainingCentreId      String    @map("training_centre_id")
  observationPeriodStart DateTime @map("observation_period_start")
  observationPeriodEnd   DateTime @map("observation_period_end")
  periodLabel           String    @map("period_label") // e.g. "2026-09"
  batchStart            DateTime? @map("batch_start")
  batchEnd              DateTime? @map("batch_end")
  plannedSeats         Int       @default(0) @map("planned_seats")
  availableSeats       Int?      @map("available_seats")
  enrolledCount        Int?      @map("enrolled_count")
  completedCount       Int?      @map("completed_count")
  certifiedCount       Int?      @map("certified_count")
  // ACTIVE | INACTIVE | COMPLETED | UNKNOWN
  status               String    @default("ACTIVE")
  dataSourceId         String?   @map("data_source_id")
  dataStatus           String    @default("DEMO") @map("data_status")
  createdAt            DateTime  @default(now()) @map("created_at")

  course               Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainingCentre       TrainingCentre @relation(fields: [trainingCentreId], references: [id], onDelete: Cascade)
  certifications       TrainingCertification[]

  @@unique([courseId, trainingCentreId, periodLabel])
  @@index([courseId])
  @@index([trainingCentreId])
  @@index([periodLabel])
  @@map("course_offerings")
}

// ---------------------------------------------------------------------
// Training Certification — certification records per offering
// Completion ≠ certification. Preserve the distinction.
// ---------------------------------------------------------------------

model TrainingCertification {
  id              String   @id @default(cuid())
  courseOfferingId String  @map("course_offering_id")
  qualificationId String?  @map("qualification_id")
  observationPeriod String @map("observation_period")
  certifiedCount  Int      @default(0) @map("certified_count")
  dataSourceId    String?  @map("data_source_id")
  dataStatus      String   @default("DEMO") @map("data_status")
  createdAt        DateTime @default(now()) @map("created_at")

  courseOffering  CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  qualification    Qualification? @relation(fields: [qualificationId], references: [id])

  @@index([courseOfferingId])
  @@index([qualificationId])
  @@map("training_certifications")
}

// ---------------------------------------------------------------------
// Course → Role Mapping (many-to-many)
// Maps courses to canonical Phase 3 JobRoles.
// ---------------------------------------------------------------------

model CourseRoleMapping {
  id            String   @id @default(cuid())
  courseId      String   @map("course_id")
  jobRoleId     String   @map("job_role_id")
  // PRIMARY | SECONDARY | OPTIONAL | UNKNOWN
  mappingType   String   @default("PRIMARY") @map("mapping_type")
  confidence     Float    @default(0.7) // 0-1
  mappingSource  String   @default("MANUAL") @map("mapping_source") // MANUAL | SEMANTIC | ADMIN | IMPORTED
  dataSourceId   String?  @map("data_source_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  jobRole       JobRole  @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@unique([courseId, jobRoleId])
  @@index([jobRoleId])
  @@map("course_role_mappings")
}

// ---------------------------------------------------------------------
// Training Supply Signal — the training-side equivalent of MarketSignal
// ---------------------------------------------------------------------

model TrainingSupplySignal {
  id                    String    @id @default(cuid())
  districtId            String?   @map("district_id")
  trainingCentreId      String?   @map("training_centre_id")
  institutionId         String?   @map("institution_id")
  courseId              String?   @map("course_id")
  qualificationId       String?   @map("qualification_id")
  sectorId              String?   @map("sector_id")
  jobRoleId             String?   @map("job_role_id")
  skillId               String?   @map("skill_id")

  observationPeriodStart DateTime  @map("observation_period_start")
  observationPeriodEnd   DateTime  @map("observation_period_end")
  periodLabel           String    @map("period_label")

  plannedCapacity       Int       @default(0) @map("planned_capacity")
  availableCapacity     Int?      @map("available_capacity")
  enrolledCount         Int?      @map("enrolled_count")
  completedCount        Int?      @map("completed_count")
  certifiedCount        Int?      @map("certified_count")

  // CATALOGUE | ACTIVE_DELIVERY | CAPACITY | ENROLLMENT | COMPLETION | CERTIFICATION
  signalType            String    @default("CAPACITY") @map("signal_type")
  // FULL | PARTIAL | INTRODUCES | ASSESSES | CERTIFIES | UNKNOWN
  coverageType          String    @default("PARTIAL") @map("coverage_type")

  confidence            Float     @default(0)
  dataStatus            String    @default("DEMO") @map("data_status")
  dataSourceId          String?   @map("data_source_id")

  createdAt             DateTime  @default(now()) @map("created_at")

  district              District?        @relation(fields: [districtId], references: [id])
  trainingCentre        TrainingCentre?  @relation(fields: [trainingCentreId], references: [id])
  institution           Institution?     @relation(fields: [institutionId], references: [id])
  course                Course?          @relation(fields: [courseId], references: [id])
  qualification         Qualification?   @relation(fields: [qualificationId], references: [id])
  sector                Sector?          @relation(fields: [sectorId], references: [id])
  jobRole               JobRole?         @relation(fields: [jobRoleId], references: [id])
  skill                 Skill?           @relation(fields: [skillId], references: [id])

  @@unique([districtId, trainingCentreId, courseId, jobRoleId, skillId, periodLabel, signalType])
  @@index([districtId])
  @@index([courseId])
  @@index([jobRoleId])
  @@index([skillId])
  @@index([periodLabel])
  @@map("training_supply_signals")
}

// ---------------------------------------------------------------------
// Training Profile — aggregated training-intelligence object
// ---------------------------------------------------------------------

model TrainingProfile {
  id              String   @id @default(cuid())
  scope           String   // STATE | DISTRICT | SECTOR | CLUSTER | ROLE | SKILL
  scopeId         String?  @map("scope_id")

  activeCourses   Int      @default(0) @map("active_courses")
  totalCourses    Int      @default(0) @map("total_courses")
  institutions    Int      @default(0)
  centres         Int      @default(0)
  plannedCapacity Int      @default(0) @map("planned_capacity")
  enrolledCount   Int      @default(0) @map("enrolled_count")
  completedCount  Int      @default(0) @map("completed_count")
  certifiedCount  Int      @default(0) @map("certified_count")

  skillCoverage   String?  @map("skill_coverage")  // JSON
  roleCoverage    String?  @map("role_coverage")   // JSON
  proficiencyCoverage String? @map("proficiency_coverage") // JSON

  avgConfidence   Float    @default(0) @map("avg_confidence")
  dataFreshness   String?  @map("data_freshness")
  dataStatus      String   @default("DEMO") @map("data_status")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([scope, scopeId])
  @@map("training_profiles")
}
